#!/bin/zsh

set -e

cd "${0:A:h:h}"

case "$1" in
pull)
  git pull --ff-only
  zsh install.sh
  ;;
update)
  # zshrc はプラグインを antidote の既定の場所ではなく ~/.antidote に置いているので、同じ場所を指定しないと更新対象が見つからない
  ANTIDOTE_HOME="${ZDOTDIR:-$HOME}/.antidote"
  source "${ANTIDOTE_HOME}/antidote.zsh"
  antidote update
  if (( $+commands[brew] )); then
    brew bundle --global
  fi
  ;;
dump)
  # Homebrew 以外のパッケージマネージャーで入れるツールは、マシンごとに必要になったときに入れるので、Brewfile に書き出さない
  brew bundle dump --global --force --no-describe --tap --formula --cask
  git diff -- Brewfile Brewfile-linux
  ;;
*)
  echo "Usage: dot pull|update|dump" >&2
  exit 1
  ;;
esac
