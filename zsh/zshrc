#!/bin/zsh
# ========================================
# Oh My Zsh 互換の変数
# ========================================

# Oh My Zsh のプラグインは補完関数などを ZSH_CACHE_DIR に書き出すので、Oh My Zsh 本体を使わない代わりに置き場所を用意する
export ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh"
mkdir -p "$ZSH_CACHE_DIR/completions" 2>/dev/null

# ========================================
# 色
# ========================================

# ターミナルの GitHub Dark Dimmed テーマで見やすい色にしている
export LSCOLORS='exfxcxdxcxegedabagacad'
export LS_COLORS='di=38;5;117:ln=38;5;87:ex=38;5;78:or=38;5;203:*.tar=38;5;221:*.tgz=38;5;221:*.zip=38;5;221:*.gz=38;5;221:*.bz2=38;5;221:*.xz=38;5;221:*.7z=38;5;221:*.rar=38;5;221:*.jpg=38;5;219:*.jpeg=38;5;219:*.png=38;5;219:*.gif=38;5;219:*.svg=38;5;219:*.webp=38;5;219:*.mp4=38;5;183:*.mov=38;5;183:*.avi=38;5;183:*.mkv=38;5;183:*.webm=38;5;183:*.mp3=38;5;147:*.wav=38;5;147:*.flac=38;5;147:*.m4a=38;5;147:*.ogg=38;5;147:*~=38;5;242:*#=38;5;242:*.bak=38;5;242:*.tmp=38;5;242:*.log=38;5;242:*.swp=38;5;242'

autoload -Uz colors
colors 2>/dev/null

# ========================================
# 履歴
# ========================================

HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
HISTSIZE=500000
SAVEHIST=500000
setopt append_history
setopt extended_history
setopt hist_ignore_dups
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt hist_save_nodups
setopt hist_find_no_dups
setopt hist_reduce_blanks
setopt hist_no_store
setopt share_history

# ========================================
# キーバインド
# ========================================

bindkey -e

bindkey '^[[3~' delete-char              # Delete キー
bindkey '^[3;5~' delete-char             # Delete キー (別の送り方をする端末)

bindkey '^F' history-incremental-search-forward
bindkey '^R' history-incremental-search-backward

bindkey '^[^[[C' forward-word            # Option (Alt) + →
bindkey '^[^[[D' backward-word           # Option (Alt) + ←
bindkey '^[[1;3C' forward-word           # Option (Alt) + → (別の送り方をする端末)
bindkey '^[[1;3D' backward-word          # Option (Alt) + ← (別の送り方をする端末)

bindkey '^[[H' beginning-of-line         # Home キー
bindkey '^[[F' end-of-line               # End キー
bindkey '^[[1~' beginning-of-line        # Home キー (別の送り方をする端末)
bindkey '^[[4~' end-of-line              # End キー (別の送り方をする端末)

bindkey '^[^?' backward-delete-word      # Option (Alt) + Backspace (Mac の delete キー)
bindkey '^[[3;3~' delete-word            # Option (Alt) + Delete キー

# ========================================
# PATH
# ========================================
# Homebrew 本体の PATH は、スクリプトからも使えるよう zshenv で設定している

path=(
  $HOME/.local/bin(N-/)
  $HOME/bin(N-/)
  $DOTFILES_DIR/bin(N-/)
  $path
)

# macOS 標準の BSD 版ではなく、Homebrew で入れた GNU 版の getopt・sed・tar を優先して使う
if [[ -n "$HOMEBREW_PREFIX" ]]; then
  path=(
    $HOMEBREW_PREFIX/opt/gnu-getopt/bin(N-/)
    $HOMEBREW_PREFIX/opt/gnu-sed/libexec/gnubin(N-/)
    $HOMEBREW_PREFIX/opt/gnu-tar/libexec/gnubin(N-/)
    $path
  )

  fpath=(
    $HOMEBREW_PREFIX/share/zsh/site-functions(N-/)
    $fpath
  )
fi

# ========================================
# asdf
# ========================================

# asdf 0.16 以降は読み込むシェル統合のスクリプトが無く、shims と補完のディレクトリを通すだけで動く
if (( $+commands[asdf] )); then
  path=(
    ${ASDF_DATA_DIR:-$HOME/.asdf}/shims
    $path
  )
  fpath=(
    ${ASDF_DATA_DIR:-$HOME/.asdf}/completions(N-/)
    $fpath
  )
fi

# ========================================
# 補完
# ========================================

setopt auto_menu

fpath=(
  $ZSH_CACHE_DIR/completions(N-/)         # Oh My Zsh のプラグインが書き出す補完関数
  ${ZDOTDIR:-$HOME}/.zsh/completions(N-/) # 手で置いた補完関数
  $fpath
)

case $OSTYPE in
  darwin*)
    fpath+=(
      /usr/share/zsh/site-functions(N-/)
    )
    ;;
  linux*)
    fpath+=(
      /usr/share/zsh/site-functions(N-/)
      /usr/share/zsh/vendor-completions(N-/)
      /usr/local/share/zsh/site-functions(N-/)
    )
    ;;
esac

zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' ignore-parents parent pwd ..
zstyle ':completion:*' list-colors 'di=34' 'ln=35' 'so=32' 'ex=31' 'bd=46;34' 'cd=43;34'
zstyle ':completion:*:sudo:*' command-path \
  /usr/local/sbin \
  /usr/local/bin \
  /usr/sbin \
  /usr/bin \
  /sbin \
  /bin \
  /usr/X11R6/bin

# 補完候補を種類ごとに見出しを付けてまとめ、説明も表示する
zstyle ':completion:*' verbose yes
zstyle ':completion:*:descriptions' format '%B%d%b'
zstyle ':completion:*:messages' format '%d'
zstyle ':completion:*:warnings' format 'No matches for: %d'
zstyle ':completion:*' group-name ''

# 補完候補をメニューから矢印キーで選べるようにする
zstyle ':completion:*' menu select
zstyle ':completion:*' format '%d'
zstyle ':completion:*' list-separator ' -- '

# コマンド名の補完では、エイリアス・組み込みコマンド・関数・外部コマンドの順に並べる
zstyle ':completion:*:*:-command-:*:*' group-order aliases builtins functions commands

# 足した補完関数のディレクトリが compinit に反映されるよう、マシン固有の path・fpath の設定は compinit より前に読み込む
if [[ -s "${ZDOTDIR:-$HOME}/.zshrc.path" ]]; then
  source "${ZDOTDIR:-$HOME}/.zshrc.path"
fi

# プラグインが読み込み時に compdef を呼ぶので、プラグインより前に補完を初期化する
autoload -Uz compinit

local zcd_file="${ZDOTDIR:-$HOME}/.zcompdump"
# [[ ]] の中ではファイル名展開が起きず glob 修飾子で古さを判定できないので、配列への代入で展開させる
local -a zcd_stale=( ${zcd_file}(N.mh+24) )

# ~/.zshrc.path で fpath に足した補完関数を次の起動で反映するため、~/.zshrc.path が定義ファイルより新しいときも作り直す
if [[ ! -f "$zcd_file" || -n "$zcd_stale" || "${ZDOTDIR:-$HOME}/.zshrc.path" -nt "$zcd_file" ]]; then
  compinit
  # compinit は補完関数の数が変わったときしか .zcompdump を書き直さず、古いと判定され続けるので更新時刻を進める
  touch "$zcd_file"
else
  # 定義ファイルが新しいうちは、補完関数の確認を省いて起動を速くする
  compinit -C
fi

# ========================================
# プラグイン (Antidote)
# ========================================

ANTIDOTE_HOME="${ZDOTDIR:-$HOME}/.antidote"
if [[ ! -d "$ANTIDOTE_HOME" ]]; then
  echo "Installing Antidote..."
  git clone --depth=1 https://github.com/mattmc3/antidote.git "$ANTIDOTE_HOME"
fi

source "$ANTIDOTE_HOME/antidote.zsh"

# launchd・1Password・devcontainer の転送などで agent が用意済みなら、別の agent を起動しない
needs_ssh_agent() {
  [[ -z "$SSH_AUTH_SOCK" ]]
}

# ssh-agent プラグインは読み込み時に設定を参照するので、読み込みより前に置く
zstyle :omz:plugins:ssh-agent identities id_rsa id_rsa2 id_github

# 起動のたびにプラグインの一覧を antidote に解釈させると遅いので、一覧が変わったときだけ読み込み用のスクリプトを作り直して、それを読む
ANTIDOTE_PLUGINS="${ZDOTDIR:-$HOME}/.zsh_plugins.zsh"
ANTIDOTE_PLUGIN_LIST="${DOTFILES_DIR}/zsh/zsh_plugins.txt"

if [[ ! -f "$ANTIDOTE_PLUGINS" || "$ANTIDOTE_PLUGIN_LIST" -nt "$ANTIDOTE_PLUGINS" ]]; then
  antidote bundle <"$ANTIDOTE_PLUGIN_LIST" >|"$ANTIDOTE_PLUGINS"
fi

source "$ANTIDOTE_PLUGINS"

# ========================================
# プラグインの設定
# ========================================

# zsh-history-substring-search が定義するウィジェットを使うので、プラグインの読み込みより後に置く
bindkey '^[[A' history-substring-search-up    # ↑
bindkey '^[[B' history-substring-search-down  # ↓

# コマンド名の補完で、エイリアスには定義の内容を説明として添えて表示する
_describe_alias() {
  local -a aliases_with_desc
  local ret=1

  local alias_name alias_def
  for alias_name in "${(@k)aliases}"; do
    alias_def="${aliases[$alias_name]}"
    aliases_with_desc+=("${alias_name}:${alias_def}")
  done

  _describe -t aliases 'alias' aliases_with_desc && ret=0
  _command_names -e && ret=0
  compadd -k builtins && ret=0
  compadd -k functions && ret=0

  return ret
}

compdef _describe_alias -command-

# ========================================
# Google Cloud SDK
# ========================================

# gcloud が配布するのは zsh の補完関数ファイルではなく bash 形式の補完定義なので、fpath に置いても読み込まれない
# 読み込み時に bash 互換レイヤーの有効化を伴い、compinit 済みであることが前提になるため compinit より後に置く
if [[ -f "$HOMEBREW_PREFIX/share/google-cloud-sdk/completion.zsh.inc" ]]; then
  source "$HOMEBREW_PREFIX/share/google-cloud-sdk/completion.zsh.inc"
fi

# ========================================
# direnv
# ========================================

if (( $+commands[direnv] )); then
  eval "$(direnv hook zsh)"
fi

# ========================================
# OS ごとの設定
# ========================================

case $OSTYPE in
  darwin*)
    export CLICOLOR=1
    if (type gls >/dev/null 2>&1); then
      alias ls="ls -F --color=auto --time-style=long-iso"
    else
      alias ls="ls -G -F -T"
    fi
    ;;
  linux*|msys*)
    alias ls="ls -F --color=auto --time-style=long-iso"
    ;;
esac

alias ll="${aliases[ls]:-ls} -lh"
alias la="${aliases[ls]:-ls} -lAh"

# ========================================
# その他のオプション
# ========================================

setopt print_eight_bit
setopt no_beep
setopt no_flow_control
setopt interactive_comments
setopt auto_pushd
setopt pushd_ignore_dups
setopt rm_star_silent

setopt no_extended_glob
setopt clobber
setopt no_auto_cd
setopt no_correct
setopt no_correct_all

# ========================================
# ターミナルのタイトル
# ========================================

# Pure を読み込んでいるときは Pure がタイトルを設定するので、ここでは設定しない
if ! typeset -f prompt_pure_precmd &>/dev/null; then
  chpwd() {
    print -Pn "\e]2;%n@%m: %~\a"  # ウィンドウのタイトル
    print -Pn "\e]1;%m: %~\a"     # タブのタイトル
  }
  # chpwd はディレクトリを移動したときにしか呼ばれないので、起動時にも一度呼ぶ
  chpwd
fi

# ========================================
# エイリアスと関数
# ========================================

function gi() { curl -sL https://www.toptal.com/developers/gitignore/api/$@ ;}
alias awsec2ls="aws ec2 describe-instances --filter \"Name=instance-state-name,Values=running\" --query 'Reservations[].Instances[].{Name: (Tags[?Key==\`Name\`].Value|[0]), InstanceId: InstanceId}'"
alias gpf='git push --force-if-includes'
alias sa='alias | grep'

# ========================================
# マシン固有の設定
# ========================================

if [[ -s "${ZDOTDIR:-$HOME}/.zshrc.local" ]]; then
  source "${ZDOTDIR:-$HOME}/.zshrc.local"
fi
