# 直後の no_global_rcs で /etc/zprofile を読まなくなるので、macOS が /etc/zprofile で行っている PATH の初期化をここで代わりに行う
if [[ "$OSTYPE" == darwin* && -x /usr/libexec/path_helper ]]; then
  eval `/usr/libexec/path_helper -s`
fi

setopt no_global_rcs

# ========================================
# dotfiles の場所
# ========================================
# ~/.zshenv はリポジトリの zsh/zshenv へのリンクなので、リンクをたどった実体の 2 つ上の階層をリポジトリの場所とする
export DOTFILES_DIR="${${(%):-%x}:A:h:h}"

# ========================================
# Homebrew
# ========================================
# スクリプトを含むすべての zsh で Homebrew のコマンドを使えるよう、zshenv で初期化する
# 出力をファイルに書き写せば起動は速くなるが、Homebrew の変更に追従する手間が要るので、毎回 brew shellenv を実行する
if [[ -x /opt/homebrew/bin/brew ]]; then
  # macOS (Apple Silicon)
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  # macOS (Intel)
  eval "$(/usr/local/bin/brew shellenv)"
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  # Linux・WSL
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

if [[ -s "${ZDOTDIR:-$HOME}/.zshenv.local" ]]; then
  source "${ZDOTDIR:-$HOME}/.zshenv.local"
fi
