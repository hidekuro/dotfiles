#!/bin/zsh
# ========================================
# Environment Variables
# ========================================

if [[ "$OSTYPE" == darwin* ]]; then
  export BROWSER='open'
fi

export EDITOR='vi'
export VISUAL='vi'
export LESS='-g -i -M -R -S -z-4'

# source-highlight による less の構文ハイライト。スクリプトがある環境でのみ有効化する
if (( $+commands[src-hilite-lesspipe.sh] )); then
  export LESSOPEN="| src-hilite-lesspipe.sh %s"
fi

# ========================================
# Load Local Configuration
# ========================================

# Load machine-local zprofile if exists.
if [[ -s "${ZDOTDIR:-$HOME}/.zprofile.local" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprofile.local"
fi
