#!/bin/zsh

# ログインを待たせないよう、現在のシェルに影響しない処理はバックグラウンドで行う
{
  # 補完の定義ファイルをコンパイルしておき、次回以降の compinit での読み込みを速くする
  zcompdump="${ZDOTDIR:-$HOME}/.zcompdump"
  if [[ -s "$zcompdump" && (! -s "${zcompdump}.zwc" || "$zcompdump" -nt "${zcompdump}.zwc") ]]; then
    # 複数のシェルが同時に起動したときにコンパイルが重ならないよう、ディレクトリの作成をロックとして使う
    if command mkdir "${zcompdump}.zwc.lock" 2>/dev/null; then
      zcompile "$zcompdump"
      command rmdir  "${zcompdump}.zwc.lock" 2>/dev/null
    fi
  fi
} &!

if [[ -o INTERACTIVE && -t 2 ]]; then
  if (( $+commands[fortune] )); then
    fortune -s
    print
  fi
fi >&2

if [[ -s "${ZDOTDIR:-$HOME}/.zlogin.local" ]]; then
  source "${ZDOTDIR:-$HOME}/.zlogin.local"
fi
