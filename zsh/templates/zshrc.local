# ~/.zshrc.local
#
# 対話シェルで、zshrc の最後に読み込まれる。
# 環境変数・エイリアス・ツールの初期化を書く。
# path と fpath の設定は、compinit より前に読み込まれる ~/.zshrc.path に書く。
#
# コマンドが入っていないマシンでエラーにならないよう、ツールを初期化する前に必ずコマンドの有無を確かめる。

# ========================================
# 環境変数
# ========================================

# 例: 既定のエディタ
# export EDITOR="vim"

# ========================================
# エイリアス
# ========================================

# 例: grep の結果に色を付ける
# alias grep="grep --color=auto"

# ========================================
# ツールの初期化
# ========================================

# 例: GitHub CLI
# if (( $+commands[gh] )); then
#   eval "$(gh completion -s zsh)"
# fi

# 例: pipx
# if (( $+commands[pipx] )); then
#   eval "$(register-python-argcomplete pipx)"
# fi

# 例: 1Password CLI のプラグイン
# if [[ -s "$HOME/.config/op/plugins.sh" ]]; then
#   source "$HOME/.config/op/plugins.sh"
# fi
