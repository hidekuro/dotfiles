# ~/.zshrc.local
#
# This file is loaded at the end of zshrc for local customizations.
# Use it for environment variables, aliases, and tool initializations.
# Put path and fpath settings in ~/.zshrc.path instead.
#
# IMPORTANT: Always check if commands exist before running them
# to avoid "command not found" errors.

# ========================================
# Environment Variables
# ========================================

# Example: Set default editor
# export EDITOR="vim"

# ========================================
# Aliases
# ========================================

# Example: Colored grep
# alias grep="grep --color=auto"

# ========================================
# Tool Initializations
# ========================================

# Example: GitHub CLI
# if (( $+commands[gh] )); then
#   eval "$(gh completion -s zsh)"
# fi

# Example: pipx (Python tool installer)
# if (( $+commands[pipx] )); then
#   eval "$(register-python-argcomplete pipx)"
# fi

# Example: 1Password CLI plugins
# if [[ -s "$HOME/.config/op/plugins.sh" ]]; then
#   source "$HOME/.config/op/plugins.sh"
# fi
