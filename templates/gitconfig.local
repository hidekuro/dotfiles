# ~/.gitconfig.local
#
# 共有の設定 (~/.config/git/config) の末尾で読み込まれる。
# 手で書くマシン固有の git の設定を書く。
# git config --global で書いた設定は ~/.gitconfig に入り、こちらより優先される。
# 以下は記入例なので、必要なものだけコメントを外して書き換える。

# --- 認証ヘルパー (credential helper) ---
# 認証ヘルパーのパスは、OS やインストール方法 (Homebrew など) によって変わる。
# [credential "https://github.com"]
# 	helper = !/path/to/gh auth git-credential

# --- 署名に使うプログラム ---
# 1Password の op-ssh-sign のような署名用プログラムのパスは、マシンごとに変わることが多い。
# [gpg "ssh"]
# 	program = /path/to/op-ssh-sign
