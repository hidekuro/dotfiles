# ~/.gitconfig.local
#
# This file is included at the end of the shared config (~/.config/git/config).
# Use it for hand-written machine-specific Git settings.
# Settings written by `git config --global` go to ~/.gitconfig, which takes precedence over this file.
# The settings below are examples. Uncomment and edit them as needed.

# --- Credential Helper ---
# The path to credential helpers can vary depending on the OS or installation method (e.g., Homebrew).
# [credential "https://github.com"]
# 	helper = !/path/to/gh auth git-credential

# --- GPG/SSH Signing Program ---
# The path to a signing program like 1Password's is often machine-specific.
# [gpg "ssh"]
# 	program = /path/to/op-ssh-sign
